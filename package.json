{
  "name": "sibling-files",
  "displayName": "Sibling-files",
  "description": "Quickly open files from current and parent directories",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "publisher": "mahdi-bayat",
  "contributes": {
    "commands": [
      {
        "command": "siblingFiles.open",
        "title": "Sibling Files: Open"
      }
    ],
    "keybindings": [
      {
        "command": "siblingFiles.open",
        "key": "ctrl+alt+f"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahdibayat/sibling-files.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
